# KnowHub backend — developer configuration template.
#
# Copy to `.env` and edit. `.env` is git-ignored; this file is committed and
# contains PLACEHOLDERS ONLY — never a real credential, token, key, or an
# endpoint belonging to any deployed environment.
#
# Every value below is a configuration EXAMPLE, not an architectural fact.
# KnowHub consumes its dependencies as configured endpoints and never detects
# how a service was provisioned: a container, Homebrew, a native install or
# any other runtime are indistinguishable to the application. Point these at
# whatever you actually run.
#
# Two supported local modes — see README.md:
#   Mode A  existing services   use what your machine already runs
#   Mode B  managed compose     docker-compose.dev.yml, the clean-room path
#
# Verify whatever you choose with:
#   uv run python scripts/check_dependencies.py

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# KNOWHUB_SERVICE_NAME=knowhub-backend
# KNOWHUB_ENVIRONMENT=local          # local | dev | sit | uat | prod

# ---------------------------------------------------------------------------
# PostgreSQL
#
# Requires PostgreSQL 15 or later with the `vector` extension AVAILABLE.
# KnowHub does not create the extension.
# ---------------------------------------------------------------------------
# Mode A — an instance you already run (example values)
KNOWHUB_DATABASE__HOST=127.0.0.1
KNOWHUB_DATABASE__PORT=5432
KNOWHUB_DATABASE__NAME=knowhub_dev
KNOWHUB_DATABASE__USER=knowhub

# Mode B — docker-compose.dev.yml publishes on deliberately non-default ports
# so it never collides with a service already on 5432 or 6379:
#   KNOWHUB_DATABASE__PORT=55432
#   KNOWHUB_DATABASE__NAME=knowhub
#   KNOWHUB_DATABASE__USER=knowhub

# The password is a SECRET REFERENCE, never the secret itself. `env:NAME`
# names an environment variable holding the value.
#
# NOTE: the referenced variable must NOT begin with `KNOWHUB_`. That namespace
# belongs to settings, and an unrecognised key inside it is rejected at load.
KNOWHUB_DATABASE__PASSWORD_REF=env:KH_DB_PASSWORD

# Supply the value itself out of band — your shell, direnv, or your OS
# keychain. Placeholder shown only to document the name:
# KH_DB_PASSWORD=change-me-locally

# ---------------------------------------------------------------------------
# Redis
#
# Endpoint only. M00 contains no Redis client; it arrives with the M2
# functionality that uses one.
# ---------------------------------------------------------------------------
KNOWHUB_REDIS__HOST=127.0.0.1
KNOWHUB_REDIS__PORT=6379
# Mode B: KNOWHUB_REDIS__PORT=56379
# If your Redis requires a password:
# KNOWHUB_REDIS__PASSWORD_REF=env:KH_REDIS_PASSWORD

# ---------------------------------------------------------------------------
# Object storage
#
# Endpoint only. M00 contains no Blob client; it arrives with the M2
# functionality that uses the Blob abstraction.
# ---------------------------------------------------------------------------
KNOWHUB_BLOB__ENDPOINT=http://127.0.0.1:10000/devstoreaccount1

# ---------------------------------------------------------------------------
# Telemetry
#
# Vendor-neutral OpenTelemetry. The destination is configuration; no code
# knows where telemetry goes.
# ---------------------------------------------------------------------------
# KNOWHUB_TELEMETRY__EXPORTER=otlp        # otlp | console | none
# KNOWHUB_TELEMETRY__OTLP_ENDPOINT=http://127.0.0.1:4318
